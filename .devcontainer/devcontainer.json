{
  "name": "loki-logback-appender",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/loki-logback-appender",

  "features": {
    // For running npm by hand in the terminal. The dev server itself lives in
    // the `docs` service; keep this version in sync with that image, since both
    // share the same node_modules on the workspace mount.
    // Node 16 is the newest release Docusaurus 1.x runs on: it is the last to
    // bundle OpenSSL 1.1.1, and from Node 17 on webpack 4's MD4 hashing fails
    // with ERR_OSSL_EVP_UNSUPPORTED.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "23"
    }
  },

  // The docs dev server, Loki and Grafana are all supervised by Docker and
  // come up with the container — nothing to start by hand.
  "runServices": ["app", "docs", "loki", "loki-multitenant", "grafana"],

  "forwardPorts": [3000, 35729, 8000, 3100, 3110],
  "portsAttributes": {
    "3000": { "label": "Docusaurus (docs)", "onAutoForward": "openBrowserOnce" },
    "35729": { "label": "Docusaurus live reload", "onAutoForward": "silent" },
    "8000": { "label": "Grafana" },
    "3100": { "label": "Loki" },
    "3110": { "label": "Loki (multi-tenant)" }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/usr/lib/jvm/msopenjdk-current",
            "default": true
          }
        ]
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  "remoteUser": "vscode"
}
